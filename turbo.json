{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "format:check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check:env-coverage": {
      "cache": false,
      "outputs": []
    },
    "check:adr-coverage": {
      "cache": false,
      "outputs": []
    }
  },
  "globalEnv": [
    "NEXT_PUBLIC_APP_BASE_URL",
    "NEXT_PUBLIC_USE_MEALPLAN_MOCK",
    "NEXT_PUBLIC_USE_RECIPE_FIXTURES",
    "NODE_ENV"
  ]
}
