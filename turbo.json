{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "format:check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check:env-coverage": {
      "cache": false,
      "outputs": []
    }
  }
}
