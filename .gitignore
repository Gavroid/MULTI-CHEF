# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Node / monorepo
node_modules/
.pnpm-store/
dist/
.next/
.turbo/
coverage/
*.tsbuildinfo
# Auto-generated by NestJS CLI / Next.js when they emit artefacts next to
# sources. They should never be committed.
apps/**/src/**/*.js
apps/**/src/**/*.js.map
apps/**/src/**/*.d.ts
apps/**/src/**/*.d.ts.map

# Logs
*.log
logs/

# Playwright (e2e)
apps/web/playwright-report/
apps/web/test-results/
apps/web/blob-report/
apps/web/playwright/.cache/

# Python
**/__pycache__/
*.pyc

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# Local-only
/tmp/

# Local secrets (NEVER commit)
.deploy-secrets/
*.age

# Husky: track the hook scripts, ignore the runtime shim dir.
.husky/_
.handover/
