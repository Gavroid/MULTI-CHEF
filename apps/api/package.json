{
  "name": "@multichef/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API (Fastify driver) with /api/v1 prefix. MC-001 scaffold; MC-002 env, MC-003 prisma readiness.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx --test-reporter=spec src/__tests__/health.test.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@multichef/config": "workspace:*",
    "@multichef/database": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "fastify": "^5.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@multichef/eslint-config": "workspace:*",
    "@multichef/typescript-config": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
