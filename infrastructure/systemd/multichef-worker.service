# MC-082 — BullMQ worker unit.
[Unit]
Description=MULTI-CHEF worker (BullMQ planning)
After=network.target postgresql.service redis-server.service

[Service]
User=multichef_app
WorkingDirectory=/opt/multichef/apps/worker
EnvironmentFile=/etc/multichef/multichef.env
ExecStart=/usr/bin/pnpm start
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
