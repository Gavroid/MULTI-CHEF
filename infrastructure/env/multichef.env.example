# Mandatory environment for /etc/multichef/multichef.env
#
# Copy this file to /etc/multichef/multichef.env and fill in real values
# for the keys marked REQUIRED. The validator
# `infrastructure/scripts/bootstrap-env.sh` enforces every key on this list
# has a value before the API starts up.
#
# D8: recipe images are intentionally NOT wired here. The MVP ships with
# /data/images/recipes/ as an unused artefact. Do NOT add S3/CDN keys
# until images are explicitly re-enabled (see PLAN-PROD-LAUNCH §1).

# ===== REQUIRED for the API to boot =====

# Postgres connection string (peer-auth in development, password in prod).
DATABASE_URL=postgres://multichef_app:PASSWORD@127.0.0.1:5432/multichef

# Session cookie HMAC key. 32+ random bytes, base64. Generated with:
#   openssl rand -base64 48
SESSION_SECRET=replace-me-base64-random-32-bytes

# Redis (BullMQ + rate-limit + idempotency-cache). Plain local redis is fine.
REDIS_URL=redis://127.0.0.1:6379

# ===== Public origin (Next.js metadataBase + og:image absolute URL) =====
# Should be the LAN or public URL ops expose multichef at.
NEXT_PUBLIC_APP_BASE_URL=http://192.168.1.95:8080
NEXT_PUBLIC_DEFAULT_LOCALE=ru

# ===== Optional but recommended for production =====

# Sentry. Empty → SDK no-op (captureException returns early).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# Health alert webhook (Slack / Telegram / Discord). Empty → no alerts.
# Slack: https://hooks.slack.com/services/T.../B.../...
# Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<ID>
HEALTH_ALERT_WEBHOOK_URL=
HEALTH_ALERT_COOLDOWN_SECONDS=600

# Node environment (production by default).
NODE_ENV=production
