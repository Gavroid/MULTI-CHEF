{
  "name": "@multichef/recommendation",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic recommendation engine: 7-factor scoring, hard filters, 8 anti-recipes, explain strings. Pure functions, no I/O (MC-032).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx --test-reporter=spec --experimental-test-coverage src/__tests__/weights.test.ts src/__tests__/types.test.ts src/__tests__/rank.test.ts \"src/__tests__/factors/*.test.ts\" \"src/__tests__/filters/*.test.ts\" \"src/__tests__/explain/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@multichef/eslint-config": "workspace:*",
    "@multichef/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
