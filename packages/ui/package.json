{
  "name": "@multichef/ui",
  "version": "0.0.0",
  "private": true,
  "description": "UI design-system package (tokens + components). Empty scaffold in MC-001; real content in MC-012.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx src/__tests__/index.test.ts",
    "build": "echo 'ui: nothing to build in scaffold (MC-001); tokens/components in MC-012'",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@multichef/eslint-config": "workspace:*",
    "@multichef/typescript-config": "workspace:*",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
