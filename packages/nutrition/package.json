{
  "name": "@multichef/nutrition",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic nutrition math: computeRecipeNutrition, scaleNutrition, combineNutrition. Pure functions, no I/O, no side effects (MC-030).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx --test-reporter=spec __tests__/compute.test.ts __tests__/scale.test.ts __tests__/rounding.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@multichef/eslint-config": "workspace:*",
    "@multichef/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
