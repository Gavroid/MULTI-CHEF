// MULTI-CHEF — Prisma schema (MC-003).
//
// Source of truth for the production data model. Generated migrations
// live in prisma/migrations/; the first migration also contains the
// custom SQL indexes from PRD §3.3 and CREATE EXTENSION statements.
//
// Conventions:
//   * id: ULID-style String @id (26 chars), generated by application
//   * money: Int (kopecks). Never Float.
//   * nutrients: Decimal. Never Float.
//   * timestamps: DateTime @db.Timestamptz(6), stored in UTC, displayed
//                 in the user's tz (User.tz).
//   * enums: pinned to the PRD values; do not rename without an ADR.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum MemberRole {
  OWNER
  MEMBER
}

enum SkillLevel {
  BEGINNER
  CONFIDENT
  EXPERIMENTER
}

enum DietType {
  NONE
  VEGETARIAN
  VEGAN
  PESCATARIAN
}

enum PreferenceKind {
  LOVE
  DISLIKE
  ALLERGY
  EXCLUDE
}

enum Unit {
  G
  ML
  PIECE
}

enum IngredientStatus {
  ACTIVE
  ARCHIVED
}

enum AmountStatus {
  PLENTY
  SOME
  LOW
}

enum Priority {
  NORMAL
  USE_FIRST
  STAPLE
}

enum StorageLocation {
  PANTRY
  FRIDGE
  FREEZER
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum RecipeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum RecipeSourceType {
  CURATED
  IMPORTED
  USER
}

enum MealPlanStatus {
  DRAFT
  GENERATING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MealPlanEntrySource {
  GENERATED
  USER_PICK
  REPLACED
  ROULETTE
}

enum StorageMethod {
  FRIDGE
  FREEZER
}

enum StorageRuleMethod {
  FREEZE_OK
  FRIDGE_ONLY
  PARTIAL_PREP
  NO_PREP
  ADD_BEFORE_SERVING
}

enum ShoppingListStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum PrepIntensity {
  MINIMAL_15
  COMPONENTS_1H
  BATCH_3H
  FULL_WEEK
}

enum PrepStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

enum JobType {
  GENERATE_TODAY
  GENERATE_PLAN
  RESCUE
  LEFTOVERS
  ROULETTE
  REGENERATE
  BUILD_SHOPPING_LIST
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Models (21)
// ---------------------------------------------------------------------------

model User {
  id               String     @id
  email            String     @unique
  passwordHash     String
  status           UserStatus @default(ACTIVE)
  tz               String     @default("Europe/Moscow")
  locale           String     @default("ru")
  isGuestConverted Boolean    @default(false)
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(6)

  sessions         Session[]
  nutritionProfile NutritionProfile?
  preferences      Preference[]
  ownedHouseholds  Household[]       @relation("HouseholdOwner")
  householdMembers HouseholdMember[]
  jobs             Job[]

  @@map("User")
}

model Session {
  id        String    @id
  userId    String
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("Session")
}

model Household {
  id                 String   @id
  name               String   @default("Моя семья")
  ownerId            String
  defaultPeopleCount Int      @default(2)
  currency           String   @default("RUB") @db.VarChar(3)
  budgetWeekKopecks  Int?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  owner         User              @relation("HouseholdOwner", fields: [ownerId], references: [id])
  members       HouseholdMember[]
  pantryItems   PantryItem[]
  mealPlans     MealPlan[]
  shoppingLists ShoppingList[]

  @@map("Household")
}

model HouseholdMember {
  householdId String
  userId      String
  role        MemberRole
  joinedAt    DateTime   @default(now()) @db.Timestamptz(6)

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([householdId, userId])
  @@map("HouseholdMember")
}

model NutritionProfile {
  userId               String     @id
  targetCalories       Int?
  targetProteinG       Int?
  targetFatG           Int?
  targetCarbsG         Int?
  mealsPerDay          Int        @default(3)
  preferredPrepMinutes Int        @default(30)
  skillLevel           SkillLevel @default(CONFIDENT)
  appliances           String[]   @default(["STOVE", "OVEN", "MICROWAVE"])
  dietType             DietType   @default(NONE)
  activityNotes        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("NutritionProfile")
}

model Preference {
  id           String         @id
  userId       String
  ingredientId String?
  kind         PreferenceKind
  note         String?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id])

  @@index([userId, kind])
  @@map("Preference")
}

model IngredientCategory {
  id        String @id
  name      String
  sortOrder Int

  ingredients   Ingredient[]
  shoppingItems ShoppingListItem[]

  @@map("IngredientCategory")
}

model Ingredient {
  id                      String           @id
  canonicalName           String           @unique
  categoryId              String
  defaultUnit             Unit
  density                 Float?
  ediblePartRatio         Float            @default(1.0)
  packageSize             Float?
  packageUnit             Unit?
  avgPriceKopecks         Int?
  defaultShelfDaysFridge  Int?
  defaultShelfDaysPantry  Int?
  defaultShelfDaysFreezer Int?
  status                  IngredientStatus @default(ACTIVE)

  category          IngredientCategory   @relation(fields: [categoryId], references: [id])
  aliases           IngredientAlias[]
  nutrition         IngredientNutrition?
  pantryItems       PantryItem[]
  recipeIngredients RecipeIngredient[]
  storageRules      StorageRule[]
  shoppingItems     ShoppingListItem[]
  preferences       Preference[]
  substitutes       RecipeIngredient[]   @relation("RecipeIngredientSubstitute")

  @@map("Ingredient")
}

model IngredientAlias {
  ingredientId String
  alias        String
  locale       String @default("ru")

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([alias, locale])
  @@index([ingredientId])
  @@map("IngredientAlias")
}

model IngredientNutrition {
  ingredientId       String  @id
  caloriesPer100g    Decimal @db.Decimal(7, 2)
  proteinPer100g     Decimal @db.Decimal(7, 2)
  fatPer100g         Decimal @db.Decimal(7, 2)
  carbsPer100g       Decimal @db.Decimal(7, 2)
  fiberPer100g       Decimal @db.Decimal(7, 2)
  source             String
  calculationVersion Int     @default(1)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@map("IngredientNutrition")
}

model PantryItem {
  id              String          @id
  householdId     String
  ingredientId    String
  quantity        Decimal         @db.Decimal(10, 2)
  unit            Unit
  estimatedGrams  Decimal         @db.Decimal(10, 2)
  amountStatus    AmountStatus
  priority        Priority        @default(NORMAL)
  storageLocation StorageLocation
  opened          Boolean         @default(false)
  purchaseDate    DateTime?       @db.Date
  expiresAt       DateTime?       @db.Date
  // ADR-0021: soft-delete tombstone + user notes (≤ 500 chars enforced in DTO).
  archivedAt      DateTime?       @db.Timestamptz(6)
  notes           String?
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)

  household  Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([householdId])
  @@index([householdId, expiresAt])
  @@index([householdId, archivedAt])
  @@index([ingredientId])
  @@map("PantryItem")
}

model Recipe {
  id                 String           @id
  title              String
  description        String?
  servings           Int
  prepMinutes        Int
  cookMinutes        Int
  difficulty         Int // 1..3
  imageKey           String?
  instructions       Json
  mealTypes          MealType[]
  tags               String[]         @default([])
  requiredAppliances String[]         @default([])
  leftoverSourceOf   String[]         @default([])
  chainTags          String[]         @default([])
  sourceType         RecipeSourceType @default(CURATED)
  status             RecipeStatus     @default(DRAFT)
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)

  ingredients RecipeIngredient[]
  nutrition   RecipeNutrition?
  entries     MealPlanEntry[]

  @@map("Recipe")
}

model RecipeIngredient {
  recipeId        String
  ingredientId    String
  quantity        Decimal @db.Decimal(10, 2)
  unit            Unit
  grams           Decimal @db.Decimal(10, 2)
  optional        Boolean @default(false)
  substitutesFor  String?
  preparationNote String?

  recipe     Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient  @relation(fields: [ingredientId], references: [id])
  substitute Ingredient? @relation("RecipeIngredientSubstitute", fields: [substitutesFor], references: [id])

  @@id([recipeId, ingredientId])
  @@index([ingredientId])
  @@map("RecipeIngredient")
}

model RecipeNutrition {
  recipeId           String  @id
  servingCalories    Decimal @db.Decimal(8, 2)
  servingProteinG    Decimal @db.Decimal(8, 2)
  servingFatG        Decimal @db.Decimal(8, 2)
  servingCarbsG      Decimal @db.Decimal(8, 2)
  servingGrams       Decimal @db.Decimal(8, 2)
  calculationVersion Int     @default(1)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@map("RecipeNutrition")
}

model StorageRule {
  id                 String            @id
  ingredientId       String?
  recipeTag          String?
  storageMethod      StorageRuleMethod
  maxHoursFridge     Int?
  maxDaysFreezer     Int?
  freezingAllowed    Boolean
  partialPrepAllowed Boolean
  addBeforeServing   String[]          @default([])
  notes              String?

  ingredient Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@map("StorageRule")
}

model MealPlan {
  id                  String         @id
  householdId         String
  startDate           DateTime       @db.Date
  endDate             DateTime       @db.Date
  peopleCount         Int
  targetBudgetKopecks Int?
  targetCalories      Int?
  targetProteinG      Int?
  targetFatG          Int?
  targetCarbsG        Int?
  status              MealPlanStatus @default(DRAFT)
  generationSettings  Json
  nutritionAccuracy   String         @default("ESTIMATED")
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(6)

  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  days          MealPlanDay[]
  shoppingLists ShoppingList[]
  prepSessions  PrepSession[]

  @@index([householdId, startDate])
  @@map("MealPlan")
}

model MealPlanDay {
  id            String   @id
  mealPlanId    String
  date          DateTime @db.Date
  totalCalories Decimal  @db.Decimal(8, 2)
  totalProteinG Decimal  @db.Decimal(8, 2)
  totalFatG     Decimal  @db.Decimal(8, 2)
  totalCarbsG   Decimal  @db.Decimal(8, 2)

  mealPlan MealPlan        @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  entries  MealPlanEntry[]

  @@unique([mealPlanId, date])
  @@map("MealPlanDay")
}

model MealPlanEntry {
  id           String              @id
  dayId        String
  mealType     MealType
  recipeId     String
  servings     Decimal             @db.Decimal(4, 1)
  portionGrams Decimal             @db.Decimal(8, 2)
  position     Int
  source       MealPlanEntrySource

  day              MealPlanDay       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  recipe           Recipe            @relation(fields: [recipeId], references: [id])
  preparedPortions PreparedPortion[]

  @@index([dayId, mealType])
  @@map("MealPlanEntry")
}

model ShoppingList {
  id                    String             @id
  mealPlanId            String?
  householdId           String
  estimatedTotalKopecks Int
  currency              String             @default("RUB") @db.VarChar(3)
  budgetLimitKopecks    Int?
  status                ShoppingListStatus @default(ACTIVE)
  createdAt             DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(6)

  mealPlan  MealPlan?          @relation(fields: [mealPlanId], references: [id])
  household Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  items     ShoppingListItem[]

  @@map("ShoppingList")
}

model ShoppingListItem {
  id                    String    @id
  shoppingListId        String
  ingredientId          String
  requiredGrams         Decimal   @db.Decimal(10, 2)
  packageQuantity       Int
  packageSize           Decimal   @db.Decimal(10, 2)
  packageUnit           Unit
  estimatedPriceKopecks Int?
  utilityScore          Int?
  purchased             Boolean   @default(false)
  purchasedAt           DateTime? @db.Timestamptz(6)
  categoryId            String
  sortOrder             Int

  shoppingList ShoppingList       @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  ingredient   Ingredient         @relation(fields: [ingredientId], references: [id])
  category     IngredientCategory @relation(fields: [categoryId], references: [id])

  @@index([shoppingListId, purchased])
  @@map("ShoppingListItem")
}

model PrepSession {
  id            String        @id
  mealPlanId    String
  scheduledAt   DateTime      @db.Timestamptz(6)
  targetMinutes Int
  intensity     PrepIntensity
  status        PrepStatus    @default(PLANNED)

  mealPlan MealPlan   @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  tasks    PrepTask[]

  @@map("PrepSession")
}

model PrepTask {
  id              String  @id
  prepSessionId   String
  title           String
  durationMinutes Int
  sequence        Int
  parallelGroup   Int?
  instructions    String
  done            Boolean @default(false)

  prepSession PrepSession @relation(fields: [prepSessionId], references: [id], onDelete: Cascade)

  @@map("PrepTask")
}

model PreparedPortion {
  id                  String        @id
  mealPlanEntryId     String
  containerNumber     Int
  preparedAt          DateTime      @db.Timestamptz(6)
  useBefore           DateTime      @db.Timestamptz(6)
  storageMethod       StorageMethod
  defrostAt           DateTime?     @db.Timestamptz(6)
  servingInstructions String?

  entry MealPlanEntry @relation(fields: [mealPlanEntryId], references: [id], onDelete: Cascade)

  @@map("PreparedPortion")
}

model Job {
  id        String    @id
  userId    String
  type      JobType
  status    JobStatus @default(QUEUED)
  progress  Int       @default(0)
  stage     String?
  resultRef String?
  error     String?
  paramsHash String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([paramsHash])
  @@map("Job")
}
