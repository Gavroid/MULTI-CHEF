# MULTI-CHEF — environment template.
#
# Copy to `.env` and replace placeholders with real values from
# `~/.deploy-secrets/multichef/INVENTORY.md`. NEVER commit `.env`.
#
# Anything read by `process.env.*` in apps/* or packages/* MUST be listed
# here. The `pnpm run check:env-coverage` script enforces this.
#
# Placeholder convention: `<set-in-INVENTORY.md>` for any value that must
# come from the secrets store, `<set-locally>` for things you are free
# to change on your dev box (e.g. port numbers).

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Ports for the dev servers. These match the defaults baked into packages/config.
WEB_PORT=3000
API_PORT=3001

# Public base URL of the API (used by web for absolute links, OAuth redirects, etc.)
APP_BASE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Development / testing toggles
# ---------------------------------------------------------------------------

# Set to "1" to enable Testcontainers integration tests in
# packages/database (requires Docker on the host). CI sets this in
# MC-005; local development can opt in.
RUN_DB_INTEGRATION=<set-locally>

# When Testcontainers can't be used (no Docker available), point this
# at a local Postgres with the schema pre-applied and the integration
# tests will skip the container spawn. Local dev only.
INTEGRATION_DATABASE_URL=<set-locally>

# ---------------------------------------------------------------------------
# Database (Postgres 16, set in compose.yml)
# ---------------------------------------------------------------------------

POSTGRES_USER=multichef
POSTGRES_PASSWORD=<set-in-INVENTORY.md>
POSTGRES_DB=multichef

# Connection string consumed by the API. Format:
#   postgresql://<user>:<password>@<host>:<port>/<db>?schema=public
DATABASE_URL=postgresql://multichef:<set-in-INVENTORY.md>@127.0.0.1:5432/multichef?schema=public

# Maximum number of connections in the API pool.
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Redis 7 (BullMQ + rate-limit)
# ---------------------------------------------------------------------------

# Leave REDIS_PASSWORD empty in dev so the compose healthcheck works
# without auth. Production MUST set a password.
REDIS_PASSWORD=<set-locally>
REDIS_URL=redis://:<set-in-INVENTORY.md>@127.0.0.1:6379

# ---------------------------------------------------------------------------
# Auth / sessions
# ---------------------------------------------------------------------------

# Used to sign session cookies. >= 32 random bytes (e.g. `openssl rand -hex 32`).
SESSION_SECRET=<set-in-INVENTORY.md>

# Used for cookie name obfuscation + CSRF state.
COOKIE_SECRET=<set-in-INVENTORY.md>

# Session lifetime in seconds. Default 30 days.
SESSION_TTL_SECONDS=2592000

# Cookie attributes. `secure` should be true in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=localhost

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated list of allowed origins for the API.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# Window in seconds for the global rate limit.
RATE_LIMIT_WINDOW_SECONDS=60

# Max requests per window per IP for the global limit.
RATE_LIMIT_MAX_REQUESTS=120

# Stricter limit for auth endpoints (per IP per window).
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info

# json | pretty
LOG_FORMAT=pretty

# Sentry DSN for the API. Empty disables Sentry.
SENTRY_DSN=<set-in-INVENTORY.md>

# Sample rate for Sentry traces (0.0 - 1.0).
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Analytics (post-MVP, optional)
# ---------------------------------------------------------------------------

# Empty disables analytics. Set to a non-empty value only after MC-040+ lands.
ANALYTICS_WRITE_KEY=<set-locally>

# ---------------------------------------------------------------------------
# AI provider keys (MC-090+, not used in MC-002 but listed for forward-compat
# because the .env.example should stay exhaustive per ADR-0007).
# ---------------------------------------------------------------------------

# OPENAI_API_KEY, ANTHROPIC_API_KEY, etc. are loaded by packages/ai later.
# Listed here as placeholders so .env.example stays the single source of truth.
OPENAI_API_KEY=<set-in-INVENTORY.md>
ANTHROPIC_API_KEY=<set-in-INVENTORY.md>
